{
  "uid": "convo-vote-feed",
  "title": "Convo · Vote Pipeline & Feed",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "App / RabbitMQ scrape health",
      "description": "0 = unreachable; 1 = healthy scrape, independent of traffic",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up{job=~\"convo-app|rabbitmq\"}",
          "legendFormat": "{{job}} — {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request rate by route and status",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (route,status,code)(rate(convo_http_requests_total[1m]))",
          "legendFormat": "{{route}} / HTTP {{status}} / code {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Vote business outcomes",
      "description": "Includes HTTP-200 business errors and middleware rejections",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (result)(rate(convo_vote_requests_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Vote/Feed P95 (seconds)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,route)(rate(convo_http_request_duration_seconds_bucket{route=~\"/api/v1/(vote|feed)\"}[5m])))",
          "legendFormat": "{{route}} P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Feed business error rate (fraction)",
      "description": "Business-code errors / all Feed requests; an idle route has no rate sample",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(sum(rate(convo_http_requests_total{route=\"/api/v1/feed\",code!=\"1000\"}[5m])) or vector(0)) / clamp_min(sum(rate(convo_http_requests_total{route=\"/api/v1/feed\"}[5m])), 0.000001)",
          "legendFormat": "Feed error fraction"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Outbox undelivered (XLEN)",
      "description": "Includes pending. Do not add pending to XLEN.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "convo_vote_outbox_length",
          "legendFormat": "Redis stream"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbox oldest age",
      "description": "No entries = zero while sampler healthy",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "convo_vote_outbox_oldest_age_seconds",
          "legendFormat": "Oldest event"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox sampling state",
      "description": "0 = Redis sample failure; use last_success_timestamp for staleness",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "convo_vote_outbox_sample_ok",
          "legendFormat": "Sample healthy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RabbitMQ ready by queue",
      "description": "Distinguish main, retry and DLQ; absent with up=0 is scrape failure",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_messages_ready{queue=~\"convo.vote.persist.*\"} or rabbitmq_queue_messages_ready{queue=~\"convo.vote.persist.*\"}",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "RabbitMQ unacked by queue",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_messages_unacked{queue=~\"convo.vote.persist.*\"} or rabbitmq_queue_messages_unacked{queue=~\"convo.vote.persist.*\"}",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Relay publication confirmation / failure",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (result)(rate(convo_vote_relay_publish_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Consumer outcomes (committed / dedup / retry / DLQ)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (result)(rate(convo_vote_consumer_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Event → MySQL commit P95",
      "description": "Only state-changing, committed events; seconds-level occurred_at; no new samples without commits",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le)(rate(convo_vote_persist_latency_seconds_bucket[5m])))",
          "legendFormat": "Commit P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Feed request rate / duration P50",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50,sum by(le)(rate(convo_http_request_duration_seconds_bucket{route=\"/api/v1/feed\"}[5m])))",
          "legendFormat": "Feed P50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "HTTP traffic rate (0 = idle if app up=1)",
      "description": "Inspect app scrape health panel alongside this; 0 rate with up=1 is idle, up=0 indicates disconnected",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(convo_http_requests_total[1m])) or vector(0)",
          "legendFormat": "HTTP traffic"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "description": "One sampler per MySQL database; sample_ok=0 means stale/not collected.",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 16,
      "title": "Content tasks by state",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "convo_content_task_state",
          "legendFormat": "{{kind}} / {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "description": "One sampler per MySQL database; sample_ok=0 means stale/not collected.",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 17,
      "title": "Oldest unfinished content task (seconds)",
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "convo_content_oldest_unfinished_seconds",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "description": "One sampler per MySQL database; sample_ok=0 means stale/not collected.",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 18,
      "title": "Content task outcomes (rate)",
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(kind,result)(rate(convo_content_projection_total[5m]))",
          "legendFormat": "{{kind}} / {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "description": "One sampler per MySQL database; sample_ok=0 means stale/not collected.",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 19,
      "title": "New Feed inbox entries (per second)",
