    {
      "type": "timeseries",
      "description": "One sampler per MySQL database; sample_ok=0 means stale/not collected.",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
