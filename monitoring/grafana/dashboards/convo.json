      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "convo_follow_oldest_unfinished_seconds",
          "legendFormat": "{{kind}} / {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "description": "One sampler per MySQL database; sample_ok=0 means stale/not collected.",
      "datasource": "Prometheus",
      "fieldConfig": {
